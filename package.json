{
  "name": "claimable-bot-promises",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build:contract": "cd contract && cargo near build non-reproducible-wasm --no-abi && mkdir -p res && cp target/near/bot_promises.wasm res/",
    "test:contract": "cd contract && cargo test",
    "build:contract:v2": "cd contract-v2 && cargo near build non-reproducible-wasm --no-abi && mkdir -p res && cp target/near/bot_promises_v2.wasm res/",
    "test:contract:v2": "cd contract-v2 && cargo test",
    "test:token": "cd token && cargo test",
    "build:contract:v3": "cd contract-v3 && cargo near build reproducible-wasm && mkdir -p res && cp target/near/bot_promises_v3.wasm res/ && cd res && shasum -a 256 bot_promises_v3.wasm > bot_promises_v3.wasm.sha256",
    "test:contract:v3": "cd contract-v3 && cargo test",
    "vectors:v3": "node app/scripts/make-v3-vectors.mjs contract-v3/tests/v3_vectors.json",
    "test:js": "node --test \"app/test/*.test.mjs\"",
    "test": "npm run test:js && npm run verify:fixtures",
    "attest": "node app/scripts/attest.mjs",
    "signature:live": "node --env-file=.env app/scripts/live-signature.mjs",
    "check:prompt": "node --env-file=.env app/scripts/check-prompt.mjs",
    "check:keys": "node --env-file=.env app/scripts/check-access-keys.mjs",
    "verify": "node app/verify.mjs",
    "customer:register": "node app/scripts/customer-register.mjs",
    "deploy:v3": "node app/scripts/deploy-v3.mjs",
    "live:v3": "node app/scripts/live-v3.mjs",
    "verify:fixtures": "node app/scripts/verify-fixtures.mjs",
    "verify:live-run": "node app/scripts/verify-live-run.mjs",
    "verify:live-run:v3": "node app/scripts/verify-live-run.mjs fixtures/runs/v3-live-run.json",
    "dev": "node --env-file=.env app/server.mjs",
    "demo:replay": "MODE=replay node app/server.mjs",
    "demo:replay:v2": "MODE=replay REPLAY_FILE=fixtures/replay/transcript-v2.json node app/server.mjs"
  },
  "dependencies": {
    "@nearai/inference-sdk": "0.3.0",
    "express": "5.3.0",
    "near-api-js": "7.4.0"
  }
}
