---
import '../styles/global.css';
import run from '../data/run.json';
import { ringSvg, storySvg, STORY_VIEWBOX } from '../lib/stills';
import { STILL_U, type Facts } from '../lib/story-model';

const REPO = (import.meta.env.PUBLIC_REPO_URL || 'https://github.com/SmtDcs/claimable-bot-promises').trim();
const SITE = (import.meta.env.PUBLIC_SITE_URL ?? '').trim();
const A = run.orders.a, B = run.orders.b, T = run.token;
const pct = (bps: number) => bps / 100;
const fmt = (n: number) => `${+n.toFixed(2)} ${T}`;
const txUrl = (h: string) => `https://testnet.nearblocks.io/txns/${h}`;
const short = (h: string) => `${h.slice(0, 8)}…${h.slice(-4)}`;
const recorded = run.recordedAt.slice(0, 10);

const facts: Facts = {
  a: { tokenPct: pct(A.tokenBps), capPct: pct(A.maxBps), paidPct: pct(A.paidBps) },
  b: { tokenPct: pct(B.tokenBps), capPct: pct(B.maxBps), paidPct: pct(B.paidBps) },
};
const unit = A.amount / 100;
const refusalErrors = [run.refusals.tamper.error, run.refusals.edited.error, run.refusals.again.error];
const storyText = {
  a: { id: A.id, chips: { none: 'NOT A PROMISE', binding: `BINDING · claimable ${fmt(A.paid)}`, claimed: `CLAIMED · paid ${fmt(A.paid)}`, capped: '', 'paid-capped': '' } },
  b: { id: B.id, chips: { none: 'NOT A PROMISE', binding: `BINDING · token ${pct(B.tokenBps)}%`, capped: `CAPPED · pays ${pct(B.paidBps)}%`, 'paid-capped': `CLAIMED · paid ${fmt(B.paid)} (cap)`, claimed: '' } },
  refusals: refusalErrors, token: T, unit,
};

const heroRing = ringSvg(88, 50, 1);
const openRing = ringSvg(72, 38, 0.12, 1.2);
const closedRing = ringSvg(72, 38, 1, 3.4);
const stills = STILL_U.map((u) => storySvg(u, facts));
const v = run.verify;

const beats = [
  { tick: 'Receipt', state: 'Order ' + A.id },
  { tick: 'Denial', state: 'Order ' + A.id },
  { tick: 'Claim', state: 'Order ' + A.id },
  { tick: 'Refusals', state: 'Order ' + A.id },
  { tick: 'Cap', state: 'Order ' + B.id },
];
const stillAlt = [
  `100 squares, one ${A.amount} ${T} order. The first ${pct(A.maxBps)} are reserved from the bond; ${pct(A.paidBps)} are marked as promised.`,
  `The ${pct(A.maxBps)} reserved squares are bracketed: they cannot be withdrawn.`,
  `${pct(A.paidBps)} squares have moved to the shopper; the reservation is released.`,
  `Squares try to leave the order and are sent back.`,
  `All 100 squares were promised; only the ${pct(B.maxBps)} above the cap line moved to the shopper.`,
];

const steps = [
  { cmd: 'npm ci', out: 'Installs dependencies. Node 22.22.2 or newer.' },
  { cmd: 'npm run verify:fixtures', out: 'Checks every recorded receipt offline.' },
  { cmd: 'npm run demo:replay:v2', out: 'Then open <code>http://127.0.0.1:8787/?offline=1</code>. Nothing is sent to testnet.' },
];
const title = 'Claimable bot promises';
const description = "Refund promises from AI support bots, signed in a NEAR AI TEE and paid from the shop's bond by a NEAR contract. Testnet.";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0a0a0a" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {SITE && <meta property="og:image" content={`${SITE.replace(/\/$/, '')}/og.png`} />}
  {SITE && <meta property="og:url" content={SITE} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} type="image/svg+xml" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<aside class="status" aria-label="Project status">
  <div class="wrap">
    <span><b>Testnet prototype</b></span>
    <span>Not audited</span>
    <span>tUSDC is a mock token</span>
  </div>
</aside>

<header class="header">
  <div class="wrap">
    <a class="brand" href="#top"><i aria-hidden="true"></i>{title}</a>
    <nav class="nav" aria-label="Sections">
      <a href="#near">How it works</a>
      <a href="#run">Demo</a>
      <a href="#verify">Verify</a>
      <a href="#limits">Limits</a>
      <a href={REPO}>GitHub</a>
    </nav>
  </div>
</header>

<main id="main">
<div class="wrap">

  <!-- Hero -->
  <section class="hero" id="top" aria-labelledby="h1">
    <div class="field pix" data-field aria-hidden="true"><canvas></canvas></div>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="label">NEAR AI · NEAR testnet</p>
        <h1 id="h1" class="rise">Make your support bot's promises binding.</h1>
        <p class="lead">The bot's replies are signed inside a NEAR AI TEE. A NEAR contract checks the signature and pays any refund the bot promised from the shop's bond, up to a cap the shop sets.</p>
        <div class="cta">
          <a class="btn solid" href="#try">Get started</a>
          <a class="btn" href={REPO}>View on GitHub</a>
        </div>
      </div>

      <article class="card hero-card" data-hero-card data-state="binding" aria-label={`Recorded receipt for order ${A.id}`}>
        <div class="pix" data-ring aria-hidden="true">
          <svg class="pix-still" viewBox={heroRing.viewBox} preserveAspectRatio="xMidYMid meet" shape-rendering="crispEdges"><path d={heroRing.dim} fill="#969696" /><path d={heroRing.bright} fill="#f4f4f2" /></svg>
          <canvas></canvas>
        </div>
        <div class="hero-card-body">
          <p class="label plain">Order {A.id} · {A.amount} {T} · max_bps {A.maxBps}</p>
          <h2 data-when="binding">Receipt on chain.</h2>
          <h2 data-when="open">Signed, not registered.</h2>
          <div class="row" data-when="binding"><span class="chip" data-kind="ok">BINDING · claimable {fmt(A.paid)}</span><span class="tag">recomputed</span></div>
          <div class="row" data-when="open"><span class="chip" data-kind="none">NOT A PROMISE</span></div>
          <code class="tokenline">{A.token}</code>
          <p class="meta">Recorded on testnet, {recorded} · <span class="nw">{run.contract}</span></p>
        </div>
      </article>
    </div>
  </section>

  <!-- Numbers -->
  <section class="band nums-band" aria-label="Numbers" style="padding:0">
    <dl class="nums">
      <div><dt>{run.numbers.tests.total}</dt><dd>tests</dd></div>
      <div><dt>{run.liveRun.txs}</dt><dd>recorded transactions in the v2 testnet run</dd></div>
      <div><dt>≈{run.numbers.tgas}</dt><dd>Tgas per tUSDC claim</dd></div>
    </dl>
  </section>

  <!-- Problem -->
  <section class="band" aria-labelledby="h-problem">
    <div class="band-head">
      <p class="label">Why</p>
      <h2 id="h-problem">“We never promised that.”</h2>
      <p>Support bots offer refunds. Later the shop denies it, and a screenshot proves nothing. Here every reply is signed, the promise is on chain, and the money is already in a bond.</p>
    </div>
    <div class="duo">
      <article class="card motif-card">
        <div class="pix" aria-hidden="true">
          <svg class="pix-still" viewBox={openRing.viewBox} preserveAspectRatio="xMidYMid meet" shape-rendering="crispEdges"><path d={openRing.dim} fill="#969696" /><path d={openRing.bright} fill="#f4f4f2" /></svg>
        </div>
        <div class="body">
          <p class="label plain">Today</p>
          <h3>A screenshot</h3>
          <p>Easy to deny. Nothing to collect.</p>
        </div>
      </article>
      <article class="card motif-card">
        <div class="pix" aria-hidden="true">
          <svg class="pix-still" viewBox={closedRing.viewBox} preserveAspectRatio="xMidYMid meet" shape-rendering="crispEdges"><path d={closedRing.dim} fill="#969696" /><path d={closedRing.bright} fill="#f4f4f2" /></svg>
        </div>
        <div class="body">
          <p class="label plain">Here</p>
          <h3>A signed receipt</h3>
          <p>The contract verifies the signature, reads the <code>PROMISE</code> line and pays <code>min(bps, max_bps)</code> of the order once.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- The recorded run, scroll-tied -->
  <section class="band story" id="run" aria-labelledby="h-run" data-story data-facts={JSON.stringify(facts)} data-text={JSON.stringify(storyText)}>
    <div class="band-head story-head">
      <p class="label">Demo</p>
      <h2 id="h-run">A recorded run on testnet</h2>
      <p>Recorded {recorded} on <code>{run.contract}</code>. Each square is 1% of a {A.amount} {T} order; the shop reserved the first {pct(A.maxBps)} from its bond.</p>
    </div>

    <div class="story-driver">
      <div class="story-stage">
        <ol class="beats">
          <li class="beat is-on">
            <div class="beat-text">
              <p class="state">01 · <b>Receipt</b> · order {A.id}</p>
              <h3>The bot promises {pct(A.tokenBps)}%.</h3>
              <div class="chat">
                <p class="msg user"><span class="who">Shopper</span>{A.message}</p>
                <div class="msg bot"><span class="who">Bot · signed in the TEE</span><span class="txt">{A.reply}</span></div>
                <code class="tokenline">{A.token}</code>
              </div>
              <p class="tx">register_receipt · <a href={txUrl(A.registerTx)}>{short(A.registerTx)}</a> · block {A.block} · testnet</p>
            </div>
            <svg class="still" viewBox={STORY_VIEWBOX} role="img" aria-label={stillAlt[0]} set:html={stills[0]} />
          </li>
          <li class="beat">
            <div class="beat-text">
              <p class="state">02 · <b>Denial</b> · order {A.id}</p>
              <h3>The shop denies it.</h3>
              <p>Receipts can't be deleted, and the {fmt(A.reserved)} cap was reserved when the order was created.</p>
            </div>
            <svg class="still" viewBox={STORY_VIEWBOX} role="img" aria-label={stillAlt[1]} set:html={stills[1]} />
          </li>
          <li class="beat">
            <div class="beat-text">
              <p class="state">03 · <b>Claim</b> · order {A.id}</p>
              <h3>The customer claims {fmt(A.paid)}.</h3>
              <p><code>claim</code> re-hashes the reply, reads <code>bps={A.tokenBps}</code> and pays from the bond.</p>
              <p class="tx">claim · <a href={txUrl(A.claimTx)}>{short(A.claimTx)}</a> · testnet</p>
            </div>
            <svg class="still" viewBox={STORY_VIEWBOX} role="img" aria-label={stillAlt[2]} set:html={stills[2]} />
          </li>
          <li class="beat">
            <div class="beat-text">
              <p class="state">04 · <b>Refusals</b> · order {A.id}</p>
              <h3>Cheating fails.</h3>
              <ol class="refusals">
                <li data-refusal="0"><span>The shopper edits <code>2000</code> to <code>3000</code> and claims</span><code>{run.refusals.tamper.error}</code><span class="tx">recomputed from the recorded bytes</span></li>
                <li data-refusal="1"><span>The shop registers an edited reply</span><code>{run.refusals.edited.error}</code><span class="tx">failed tx · <a href={txUrl(run.refusals.edited.tx)}>{short(run.refusals.edited.tx)}</a> · testnet</span></li>
                <li data-refusal="2"><span>The shopper claims a second time</span><code>{run.refusals.again.error}</code></li>
              </ol>
            </div>
            <svg class="still" viewBox={STORY_VIEWBOX} role="img" aria-label={stillAlt[3]} set:html={stills[3]} />
          </li>
          <li class="beat">
            <div class="beat-text">
              <p class="state">05 · <b>Cap</b> · order {B.id}</p>
              <h3>A {pct(B.tokenBps)}% promise pays {pct(B.paidBps)}%.</h3>
              <div class="chat">
                <p class="msg user"><span class="who">Shopper</span>{B.message}</p>
                <code class="tokenline">{B.token}</code>
              </div>
              <p>This shop's prompt was misconfigured to allow full refunds. The on-chain <code>max_bps {B.maxBps}</code> caps the payout at {fmt(B.paid)}.</p>
              <p class="tx">claim · <a href={txUrl(B.claimTx)}>{short(B.claimTx)}</a> · token_bps {B.tokenBps}, paid_bps {B.paidBps} · testnet</p>
            </div>
            <svg class="still" viewBox={STORY_VIEWBOX} role="img" aria-label={stillAlt[4]} set:html={stills[4]} />
          </li>
        </ol>

        <div class="story-vis" aria-hidden="true">
          <div class="vis-top"><span>Order <b data-out="order">{A.id}</b> · {A.amount} {T} · max_bps {A.maxBps}</span><span class="legend"><i class="k-res"></i>reserved <i class="k-pro"></i>promised <i class="k-paid"></i>paid out</span></div>
          <canvas></canvas>
          <div class="vis-bottom"><span class="chip" data-out="chip" data-kind="none">NOT A PROMISE</span><span>Reserved <b data-out="reserved">0 {T}</b></span><span>Paid <b data-out="paid">0 {T}</b></span></div>
        </div>

        <ol class="story-ticks" aria-label="Jump to a step">
          {beats.map((b, i) => <li><button type="button" aria-label={`${String(i + 1).padStart(2, '0')} ${b.tick}`}>{String(i + 1).padStart(2, '0')}<span>&nbsp;{b.tick}</span></button></li>)}
        </ol>
      </div>
    </div>

    <div class="story-note">
      <p>Transactions are real testnet data. Badges before each claim and the edited-bytes result are recomputed from the recorded bytes.</p>
    </div>
  </section>

  <!-- v3: customer registration -->
  <section class="band" id="v3" aria-labelledby="h-v3">
    <div class="band-head">
      <p class="label">v3</p>
      <h2 id="h-v3">The customer registers the promise</h2>
      <p>On v2 a shop could skip registering a reply it regrets. On v3 (<code>claimable-promises.testnet</code>) the customer registers it. The shop's server signs every request it sends to NEAR AI, so the contract accepts only replies the shop's own bot produced for that order and buyer. The contract has no access keys and no upgrade method.</p>
      <p>The shop's server is still the only source of the exact reply bytes; a server that withholds them can't be forced to hand them over.</p>
      <p><a href={`${REPO}/blob/main/docs/V3.md`}>Read the design →</a></p>
    </div>
  </section>

  <!-- Verify in the browser -->
  <section class="band verify" id="verify" aria-labelledby="h-verify" data-verify data-bundle={JSON.stringify(v)}>
    <div class="band-head">
      <p class="label">Verify</p>
      <h2 id="h-verify">Check the signature in your browser</h2>
      <p>The reply for order {v.orderId}, byte for byte as the TEE returned it. Edit it and the check fails.</p>
    </div>
    <div class="verify-grid">
      <article class="card v-reply">
        <p class="label plain">Reply bytes · order {v.orderId}</p>
        <p class="msg" data-v="reply">{A.reply}</p>
        <code class="tokenline" data-v="token">{A.token}</code>
        <div class="v-actions">
          <button class="btn" type="button" data-act="edit" aria-pressed="false">Edit 2000 → 3000</button>
          <button class="btn" type="button" data-act="forge" aria-pressed="false" disabled>Also rewrite the signed hash</button>
          <button class="btn" type="button" data-act="reset" disabled>Reset</button>
        </div>
      </article>
      <div class="card" aria-live="polite">
        <div class="v-rows">
          <div class="v-row" data-v="row-hash" data-state="na">
            <h3>1 · sha256(reply bytes) equals the signed hash</h3>
            <span class="v-res">RECORDED</span>
            <dl><dt>computed</dt><dd data-v="computed">{short(v.responseHash)}</dd><dt>signed</dt><dd data-v="claimed">{short(v.responseHash)}</dd></dl>
          </div>
          <div class="v-row" data-v="row-sig" data-state="na">
            <h3>2 · Ed25519 signature over the signed text</h3>
            <span class="v-res">RECORDED</span>
            <dl><dt>key</dt><dd>{short(v.publicKeyHex)}</dd><dt>text</dt><dd data-v="signed">{v.model}:{short(v.requestHash)}:{short(v.responseHash)}</dd></dl>
          </div>
        </div>
        <div class="v-verdict" data-v="verdict" data-state="na">
          <span class="label plain">Result in this browser</span>
          <span class="v-res">NOT CHECKED HERE</span>
          <p data-v="explain">Without JavaScript nothing is checked on this page. <code>npm run verify:fixtures</code> runs the same check locally.</p>
        </div>
      </div>
    </div>
    <p class="v-not"><b>What this does not prove.</b> This checks the bytes against the key. It doesn't read the chain or the key's TEE attestation; <code>npm run verify</code> does the on-chain part.</p>
  </section>

  <!-- What NEAR does -->
  <section class="band" id="near" aria-labelledby="h-near">
    <div class="band-head">
      <p class="label">How it works</p>
      <h2 id="h-near">What the contract enforces</h2>
    </div>
    <div class="bento">
      <article class="card w7">
        <p class="n">01</p>
        <h3>Signature check</h3>
        <p><code>register_receipt</code> runs <code>env::ed25519_verify</code> over the model id and the hashes of the request and response.</p>
        <code class="tokenline">z-ai/glm-5.3-flash:sha256(request bytes):sha256(response bytes)</code>
      </article>
      <article class="card w5">
        <p class="n">02</p>
        <h3>Shop-set cap</h3>
        <p><code>claim</code> pays <code>min(bps, max_bps)</code> × the order amount, once.</p>
        <code class="tokenline">min({B.tokenBps}, {B.maxBps}) = {B.paidBps}</code>
      </article>
      <article class="card w5">
        <p class="n">03</p>
        <h3>Reserved funds</h3>
        <p>The cap is locked from the bond when the order is created.</p>
      </article>
      <article class="card w7">
        <p class="n">04</p>
        <h3>Scoped keys</h3>
        <p>The shop's server can only register receipts; the demo shopper key can only claim.</p>
      </article>
    </div>
  </section>

  <!-- Limits -->
  <section class="band" id="limits" aria-labelledby="h-limits">
    <div class="band-head">
      <p class="label">Limits</p>
      <h2 id="h-limits">Limitations</h2>
    </div>
    <ol class="limits">
      <li><span class="n">01</span><h3>Testnet only</h3><p>Nothing is on mainnet. tUSDC is a mock token with no value.</p></li>
      <li><span class="n">02</span><h3>Full-access keys on v1/v2</h3><p>Whoever holds those keys could redeploy the v1/v2 contracts. v3 has no access keys.</p></li>
      <li><span class="n">03</span><h3>Attestation is off chain</h3><p>The contract can't verify a TDX quote. Only the attestation record's hash is on chain.</p></li>
      <li><span class="n">04</span><h3>The shop sets expiry</h3><p>A promise must be claimed before the order expires.</p></li>
      <li><span class="n">05</span><h3>Claims are public</h3><p>A claim puts the reply bytes on chain.</p></li>
      <li><span class="n">06</span><h3>Demo key, no wallet</h3><p>The demo uses a claim-only function-call key on the server instead of a wallet login.</p></li>
      <li><span class="n">07</span><h3>The shop must register the reply</h3><p>The demo runs on v2, where the shop can still ignore a reply it doesn't want to honour. v3 fixes this.</p></li>
      <li><span class="n">08</span><h3>The demo badge is the shop's page</h3><p>The BINDING badge trusts the RPC and contract the shop's server names. Run <code>npm run verify</code> for an independent check.</p></li>
    </ol>
  </section>

  <!-- Try -->
  <section class="band" id="try" aria-labelledby="h-try">
    <div class="band-head">
      <p class="label">Get started</p>
      <h2 id="h-try">Run it locally</h2>
      <p>Node 22.22.2+. No keys needed.</p>
    </div>
    <div class="try-grid">
      <ol class="steps">
        <li class="step"><span class="n">00</span><code>git clone {REPO}</code><button class="copy" type="button" data-copy={`git clone ${REPO}`} hidden>Copy</button></li>
        {steps.map((s, i) => (
          <li class="step"><span class="n">{String(i + 1).padStart(2, '0')}</span><code>{s.cmd}</code><button class="copy" type="button" data-copy={s.cmd} hidden aria-label={`Copy ${s.cmd}`}>Copy</button><p set:html={s.out} /></li>
        ))}
      </ol>
      <dl class="card facts">
        <div><dt>Contract (v3)</dt><dd>claimable-promises.testnet</dd></div>
        <div><dt>Contract (v2)</dt><dd>{run.contract}</dd></div>
        <div><dt>Mock token</dt><dd>sm1110-tusdc.testnet ({T}, 6 decimals)</dd></div>
        <div><dt>Bot model</dt><dd>NEAR AI Cloud {v.model}</dd></div>
      </dl>
    </div>
  </section>

  <!-- Footer -->
  <footer class="band footer">
    <div class="field pix" data-field aria-hidden="true"><canvas></canvas></div>
    <div class="footer-grid">
      <div>
        <p><b>{title}</b> · MIT · <a href={REPO}>GitHub</a></p>
      </div>
      <div class="small">
        <p>Testnet only. Not audited.</p>
      </div>
    </div>
  </footer>

</div>
</main>
<script>
  import '../scripts/main.ts';
</script>
</body>
</html>
