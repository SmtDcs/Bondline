# INTERFACES.md section 13. Copy to .env and fill; .env is never committed.
MODE=live
PORT=8787
NEAR_RPC_URL=https://test.rpc.fastnear.com
# CONTRACT_ID is the v2 deployment (v2.cbp-sm1110.testnet), the current one;
# the v1 contract stays as history and `npm run verify:fixtures` keeps working against it.
CONTRACT_ID=
MERCHANT_ID=
RELAYER_SECRET_KEY=
BUYER_ID=
BUYER_CLAIM_SECRET_KEY=
NEARAI_API_KEY=
# Scripts only (demo-setup-v2.mjs, demo-setup.sh V2=1, verify hints): the NEP-141 token used for bonds. Not a key.
TOKEN_ID=
MODEL=z-ai/glm-5.3-flash
SIGNING_ALGO=ed25519
# DEMO_ORDERS is order_id:label:policy_bps[:naive],...  The labels contain spaces, so keep the value in
# quotes (node --env-file and app/scripts/demo-setup.sh both accept the quoted form). The optional trailing
# `naive` flag marks the badly configured bot (PLAN R4, CR-3): it gets the naive system prompt and is told
# it may offer 100%, while the on-chain max_bps still caps the payout. The page labels it accordingly.
# DEMO_ORDERS="A123-01:Broken mug:2000,A124-01:Late delivery:2000:naive"
# Leave DEMO_ORDERS unset to use the default (A123-01 / A124-01); an empty value is treated as unset.
# Operator scripts only (app/scripts/demo-setup-v2.mjs, app/scripts/live-v2.mjs): full-access keys of the repository's own
# throwaway testnet accounts, format ed25519:<base58 secret>. The scripts parse this file themselves and never print a value.
# The app (`npm run dev`) does not read any of these.
CBP_SHOP_ACCOUNT=
CBP_SHOP_KEY=
CBP_ALICE_ACCOUNT=
CBP_ALICE_KEY=
CBP_BOB_ACCOUNT=
CBP_BOB_KEY=
CBP_V2_OWNER_ACCOUNT=
CBP_V2_OWNER_KEY=
CBP_TUSDC_OWNER_ACCOUNT=
CBP_TUSDC_OWNER_KEY=
